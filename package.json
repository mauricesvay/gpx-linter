{
	"name": "gpx-route-linter",
	"version": "1.0.0",
	"description": "A configurable rule-based linter for GPX bike routes",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"gpxlint": "dist/cli.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "npm test && npm run build",
		"prepublishOnly": "npm run check"
	},
	"keywords": [
		"gpx",
		"cycling",
		"lint"
	],
	"license": "ISC",
	"type": "commonjs",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@types/leaflet": "^1.9.22",
		"commander": "^12.1.0",
		"fast-xml-parser": "^5.11.2",
		"js-yaml": "^4.1.0",
		"pmtiles": "^4.5.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.10.0",
		"typescript": "^5.7.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	}
}
